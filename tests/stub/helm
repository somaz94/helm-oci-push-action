#!/usr/bin/env bash
# Stand-in for helm in the retry tests: the first FAIL_PUSHES pushes fail with
# GHCR's transient Tag error, every other command goes to the real binary.
set -euo pipefail

if [[ "${1:-}" == "push" ]]; then
  state=/tmp/helm-stub-pushes
  n=$(( $(cat "$state" 2>/dev/null || echo 0) + 1 ))
  echo "$n" > "$state"
  if (( n <= ${FAIL_PUSHES:-0} )); then
    echo 'Error: failed to perform "Tag" on destination: sha256:0000: not found' >&2
    exit 1
  fi
  echo "Pushed: stub"
  exit 0
fi

exec /usr/local/bin/helm "$@"
